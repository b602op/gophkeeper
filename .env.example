# Пример переменных окружения для сервера GophKeeper.
# Скопируйте файл в .env и заполните значения. .env в репозиторий не коммитится.

# Адрес прослушивания HTTP-сервера
GOPHKEEPER_RUN_ADDRESS=localhost:8080

# DSN для подключения к PostgreSQL
GOPHKEEPER_DATABASE_DSN=postgres://gophkeeper:gophkeeper@localhost:5432/gophkeeper?sslmode=disable

# Секрет для подписи JWT. Обязателен, без него сервер не стартует.
GOPHKEEPER_JWT_SECRET=

# Время жизни access-токена
GOPHKEEPER_TOKEN_TTL=24h

# Уровень логирования: debug, info, warn, error
GOPHKEEPER_LOG_LEVEL=info

# Включить HTTPS
GOPHKEEPER_ENABLE_HTTPS=false

# Пути к TLS-сертификату и ключу (нужны при ENABLE_HTTPS=true)
GOPHKEEPER_TLS_CERT_FILE=
GOPHKEEPER_TLS_KEY_FILE=

# Стоимость bcrypt (10..31)
GOPHKEEPER_BCRYPT_COST=12

# Каталог с SQL-миграциями
GOPHKEEPER_MIGRATIONS_DIR=internal/repository/migrations
